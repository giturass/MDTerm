<com.termux.app.terminal.TermuxActivityRootView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_termux_root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    android:fitsSystemWindows="true">

    <RelativeLayout
        android:id="@+id/activity_termux_root_relative_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="3dp"
        android:layout_marginVertical="0dp"
        android:orientation="vertical">

        <com.termux.app.terminal.TerminalDrawerLayout
            android:id="@+id/drawer_layout"
            android:layout_width="match_parent"
            android:layout_alignParentTop="true"
            android:layout_above="@+id/terminal_toolbar"
            android:layout_height="match_parent">

            <FrameLayout
                android:id="@+id/terminal_surface"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/colorSurfaceContainer">

                <com.termux.view.TerminalView
                    android:id="@+id/terminal_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:defaultFocusHighlightEnabled="false"
                    android:focusableInTouchMode="true"
                    android:scrollbarThumbVertical="@drawable/terminal_scroll_shape"
                    android:scrollbars="vertical"
                    tools:ignore="UnusedAttribute" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/left_drawer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:descendantFocusability="blocksDescendants"
                android:background="@drawable/terminal_drawer_background">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/terminal_drawer_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="12dp"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="12dp"
                            android:src="@drawable/ic_mdterm"
                            android:importantForAccessibility="no" />

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/application_name"
                            android:textAppearance="?attr/textAppearanceHeadlineSmall"
                            android:textColor="?attr/colorOnSurface" />

                        <ImageButton
                            android:id="@+id/file_system_button"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:padding="12dp"
                            android:src="@drawable/ic_folder"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/action_open_file_system"
                            app:tint="?attr/termuxActivityDrawerImageTint" />

                        <ImageButton
                            android:id="@+id/settings_button"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:padding="12dp"
                            android:src="@drawable/ic_settings"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/action_open_settings"
                            app:tint="?attr/termuxActivityDrawerImageTint" />
                    </LinearLayout>

                    <com.termux.app.terminal.TerminalDrawerRecyclerView
                        android:id="@+id/terminal_drawer_list"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="88dp"
                        android:clipToPadding="false"
                        android:scrollbars="none" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/terminal_drawer_actions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|bottom"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="16dp"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/new_session_button"
                        style="@style/Widget.Material3.FloatingActionButton.Surface"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:contentDescription="@string/action_new_session"
                        android:tooltipText="@string/action_new_session"
                        app:backgroundTint="?attr/colorPrimary"
                        app:fabSize="normal"
                        app:maxImageSize="24dp"
                        app:rippleColor="?attr/colorControlHighlight"
                        app:srcCompat="@drawable/ic_new_session"
                        app:tint="?attr/colorOnPrimary"
                        app:useCompatPadding="false" />
                </FrameLayout>
            </FrameLayout>

        </com.termux.app.terminal.TerminalDrawerLayout>

        <HorizontalScrollView
            android:id="@+id/terminal_toolbar"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/terminal_keys_surface"
            android:layout_alignParentBottom="true"
            android:fillViewport="true"
            android:layoutDirection="ltr"
            android:scrollbars="none">

            <include layout="@layout/view_terminal_toolbar_extra_keys" />

        </HorizontalScrollView>

    </RelativeLayout>

    <View
        android:id="@+id/activity_termux_bottom_space_view"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/transparent" />

</com.termux.app.terminal.TermuxActivityRootView>
