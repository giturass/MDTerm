<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- BaseToolbar Title text appearance. -->
    <style name="TextAppearance.Widget.BaseToolbar.Title" parent="TextAppearance.Material3.TitleLarge"/>

    <!-- BaseToolbar Subtitle text appearance. -->
    <style name="TextAppearance.Widget.BaseToolbar.Subtitle" parent="TextAppearance.Material3.BodyMedium"/>

    <style name="BaseDialog.Title.Panel" parent="MaterialAlertDialog.Material3.Title.Panel"/>

    <style name="BaseDialog.Message.Text.Light" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textColorLink">?attr/colorPrimary</item>
    </style>

    <style name="BaseDialog.Message.Text.Dark" parent="BaseDialog.Message.Text.Light"/>

    <!-- ViewDivider style. -->
    <style name="ViewDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginTop">@dimen/activity_vertical_margin</item>
        <item name="android:layout_marginBottom">@dimen/activity_vertical_margin</item>
        <item name="android:background">?android:attr/listDivider</item>
    </style>

</resources>
