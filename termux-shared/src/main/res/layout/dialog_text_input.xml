<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:paddingHorizontal="24dp" android:paddingTop="16dp" android:paddingBottom="8dp"
    android:orientation="vertical">
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        app:hintEnabled="false" app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/dialog_text_input" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="56dp"
            android:inputType="text" android:singleLine="true" android:imeOptions="actionDone"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
